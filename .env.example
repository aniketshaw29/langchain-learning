# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in what you need. Nothing here is secret
# if you only use Ollama, but never commit a real .env file to git!
# ---------------------------------------------------------------------------

# Who drives the LLM calls?  "openai" (default, needs a key) or "ollama" (local).
#   openai -> uses langchain-openai's ChatOpenAI (GPT-4o / gpt-4o-mini)
#   ollama -> uses langchain-ollama's ChatOllama (free, runs on your machine)
LLM_PROVIDER=openai

# Only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=

# Only needed when LLM_PROVIDER=ollama (the default model most people `ollama pull`)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Which embeddings to use for RAG (lesson 03). "openai" or "ollama".
#   ollama needs:  ollama pull nomic-embed-text
EMBEDDING_PROVIDER=openai

# How verbose the examples are
LOG_LEVEL=INFO