# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in what you need. Never commit a real .env!
#
# You can run the WHOLE project with any of the chat providers below -- just
# change LLM_PROVIDER and drop in the matching key. Same code, any model.
# ---------------------------------------------------------------------------

# ----- The "brain": which chat model powers every lesson? -----
#   openai    -> GPT family          (needs OPENAI_API_KEY)
#   anthropic -> Claude              (needs ANTHROPIC_API_KEY)
#   google    -> Gemini              (needs GOOGLE_API_KEY)
#   groq      -> Llama/Qwen, blazing fast (needs GROQ_API_KEY)
#   ollama    -> your local models   (free, offline; run: ollama serve)
LLM_PROVIDER=openai

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Optional: override the default model per provider
# (model names change -- these are just sensible defaults)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GOOGLE_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ----- Embeddings (only used by lesson 03, RAG) -----
# Chat and embeddings can differ. NOTE: Anthropic & Groq have NO embedding
# API, so if you chat with them you must still point this at a provider
# that DOES: "openai" | "google" | "ollama".
EMBEDDING_PROVIDER=openai
# EMBEDDING_PROVIDER=ollama   # needs:  ollama pull nomic-embed-text
# EMBEDDING_PROVIDER=google   # uses GOOGLE_API_KEY, model "models/embedding-001"

LOG_LEVEL=INFO